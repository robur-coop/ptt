opam-version: "2.0"
maintainer: "Robur <team@robur.coop>"
authors: ["Robur <team@robur.coop>"]
homepage: "https://github.com/robur-coop/ptt"
dev-repo: "git+https://github.com/robur-coop/ptt.git"
bug-reports: "https://github.com/robur-coop/ptt/issues"
license: "AGPL-3.0-or-later"

depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.0.0"}
  "mirage-crypto-rng-mkernel"
  "dns-certify"
  "dns-tsig"
  "mfat"
  "mnet-dns"
  "mnet-cli"
  "progress"
  "flux"
  "carton"
  "art"
  "encore"
  "cattery"
  "msendmail"
  "arc"
  "dmarc"
  "uspf"
  "dkim"
  "re"
  "uuidm"
  "unic" {build}
  "mfetch" {build}
  "duration" {>= "0.3.0"}
]
build: [
  [make "all"]
]
synopsis: "Unikernels for SMTP services"
pin-depends: [
  [ "zarith.dev"              "git+https://github.com/mirage/Zarith.git#df8969d9bb95cffca13e31a615189ab27ada0684" ]
  [ "msendmail.dev"           "git+https://github.com/mirage/colombe.git#de2847fbb156fb4686ef9fde69e23090a8b8854e" ]
  [ "colombe.dev"             "git+https://github.com/mirage/colombe.git#de2847fbb156fb4686ef9fde69e23090a8b8854e" ]
  [ "sendmail.dev"            "git+https://github.com/mirage/colombe.git#de2847fbb156fb4686ef9fde69e23090a8b8854e" ]
  [ "mnet.dev"                "git+https://github.com/robur-coop/mnet.git#c85e0ab53ec8b48b74e7cd977e4701cb9380a8dc" ]
  [ "mnet-cli.dev"            "git+https://github.com/robur-coop/mnet.git#c85e0ab53ec8b48b74e7cd977e4701cb9380a8dc" ]
  [ "mnet-dns.dev"            "git+https://github.com/robur-coop/mnet.git#c85e0ab53ec8b48b74e7cd977e4701cb9380a8dc" ]
  [ "mnet-happy-eyeballs.dev" "git+https://github.com/robur-coop/mnet.git#c85e0ab53ec8b48b74e7cd977e4701cb9380a8dc" ]
  [ "mnet-tls.dev"            "git+https://github.com/robur-coop/mnet.git#c85e0ab53ec8b48b74e7cd977e4701cb9380a8dc" ]
  [ "unic.dev"                "git+https://github.com/robur-coop/unic.git#02fe3283c384f387e38f4f29c28688db22ad4a28" ]
  [ "uniq.dev"                "git+https://github.com/robur-coop/unic.git#02fe3283c384f387e38f4f29c28688db22ad4a28" ]
]
